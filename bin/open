#!/usr/bin/env bash  # Termux: /data/data/com.termux/files/usr/bin/bash
# open - macOS-style file/URL opener for Termux (uses termux-open)
TARGET="${1:?usage: open <file|url>}"
if command -v termux-open >/dev/null 2>&1; then
  termux-open "$TARGET"
else
  # fallback: try xdg-open-like behavior via am/start-intent is not available; print hint
  echo "open: install termux-api (pkg install termux-api) to enable." >&2
  exit 1
fi
